<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="[%d{HH:mm:ss} %level]: %msg%n"/></Console>
    <RollingFile name="File" fileName="logs/latest.log" filePattern="logs/server-%i.log.gz">
      <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss} %level]: %msg%n"/>
      <Policies><SizeBasedTriggeringPolicy size="10 MB"/></Policies>
      <DefaultRolloverStrategy max="3"/>
    </RollingFile>
  </Appenders>
  <Loggers><Root level="info"><AppenderRef ref="Console"/><AppenderRef ref="File"/></Root></Loggers>
</Configuration>
